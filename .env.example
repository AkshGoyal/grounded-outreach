# Copy to .env and fill in real values.  .env is git-ignored and must NEVER be
# committed - see .gitignore. Campaign settings are validated at startup;
# the research pilot reads only its API keys and model.

# --- The model that writes the drafts -------------------------------------
# "openrouter" gives you many models behind one key; "anthropic" goes direct.
OUTREACH_LLM_PROVIDER=openrouter
OUTREACH_LLM_MODEL=openai/gpt-5.6-luna
OUTREACH_OPENROUTER_API_KEY=sk-or-replace-me

# Optional research pilot only (docs/RESEARCH_PILOT.md).
OUTREACH_PARALLEL_API_KEY=
# Pilot provider prices are capped at $1/M input and $5/M output tokens.
# A model exceeding those prices will fail safely; Haiku 4.5 fits these caps.

# Only needed if OUTREACH_LLM_PROVIDER=anthropic
# OUTREACH_ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Mailbox (Zoho, over SMTP + IMAP) -------------------------------------
# Zoho's setup wizard prints the exact hostnames for your data centre.
# Use the India data-centre hosts — see docs/ROADMAP.md, Track D.
OUTREACH_MAIL_SMTP_HOST=smtppro.zoho.in
OUTREACH_MAIL_SMTP_PORT=465
OUTREACH_MAIL_IMAP_HOST=imap.example.invalid
OUTREACH_MAIL_IMAP_PORT=993
OUTREACH_MAIL_USERNAME=aksh@starthreads.in
OUTREACH_MAIL_PASSWORD=replace-with-app-specific-password

# --- Who the email is from (D-008) ----------------------------------------
# Every email carries your name, company and physical address, and a way to
# opt out. That is a legal baseline for outreach, so sending refuses to start
# without them. Use your real registered business address.
OUTREACH_SENDER_NAME=Aksh Goyal
OUTREACH_SENDER_EMAIL=aksh@starthreads.in
OUTREACH_SENDER_COMPANY=Star Threads Private Limited
OUTREACH_SENDER_ADDRESS=replace with your full business address

# --- Sending limits ----------------------------------------------------------
# The domain had never sent email before this, so start low. Raise it once
# replies show your mail is landing in inboxes rather than spam.
OUTREACH_DAILY_SEND_CAP=10
OUTREACH_SEND_GAP_SECONDS=60

# --- Storage (D-006) ------------------------------------------------------
# Lives under data/, which is git-ignored: this file holds recipient PII.
OUTREACH_DB_PATH=data/outreach.db

# Research runs: separate from the completed $1 comparison pilot.
# OUTREACH_PARALLEL_API_KEY=
OUTREACH_RESEARCH_MODEL=anthropic/claude-haiku-4.5
OUTREACH_RESEARCH_MAX_BUDGET_USD=5
OUTREACH_RESEARCH_DAILY_BUDGET_USD=5

# Set a strong password and your actual hostname before publishing the workspace.
# Keep secret values in Cloud environment settings, never in this example file.
# OUTREACH_APP_PASSWORD=
OUTREACH_ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
# Optional stable Fernet encryption key; otherwise a private mail-credentials.key
# is created beside the database. Back up that key separately and securely.
# OUTREACH_CREDENTIAL_KEY=

# --- Gmail / Zoho OAuth mailbox connection (docs/OAUTH_SETUP.md) ----------
# Use the real Python app's HTTPS origin; the static phone demo cannot receive OAuth.
# App password above protects the workspace, not the email provider account.
# OUTREACH_OAUTH_PUBLIC_URL=https://YOUR-APP
# OUTREACH_GOOGLE_CLIENT_ID=
# OUTREACH_GOOGLE_CLIENT_SECRET=
# OUTREACH_ZOHO_CLIENT_ID=
# OUTREACH_ZOHO_CLIENT_SECRET=
# Add YOUR-APP's hostname to OUTREACH_ALLOWED_HOSTS. Store client secrets only
# in host environment settings. OAuth refresh tokens are encrypted in the DB.

# --- Hosted backend startup (docs/HOSTED_APP.md) --------------------------
# Use python -m outreach.hosted with a real persistent volume and HTTPS host.
# OUTREACH_HOSTED_DATA_DIR=/var/data/outreach
# Render's RENDER_EXTERNAL_URL supplies the origin automatically, unless the
# explicit OUTREACH_OAUTH_PUBLIC_URL above selects a custom HTTPS domain.
# Hosted startup keeps SQLite, campaigns and encryption key together.
# FORWARDED_ALLOW_IPS should contain only verified hosting proxy addresses.
# Default is loopback; do not broadly trust arbitrary forwarded headers.
